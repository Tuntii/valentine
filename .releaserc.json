{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/valentine-windows-x64.zip", "label": "Windows (x64)" },
          { "path": "dist/valentine-macos-arm64.tar.gz", "label": "macOS (Apple silicon)" },
          { "path": "dist/valentine-linux-x64.tar.gz", "label": "Linux (x64)" }
        ]
      }
    ]
  ]
}
